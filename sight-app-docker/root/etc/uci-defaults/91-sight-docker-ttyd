#!/bin/sh
# ttyd 是容器终端的依赖，它的包默认在 LAN 上开一个 /bin/login 登录终端（7681），本插件用不到，首次安装时关掉。
# 只关没有显式设置 enable 的 /bin/login 实例；标记 dockerd.globals.sight_ttyd_login_disabled 保证只做一次，
# 之后用户自己打开的不会再被关掉（dockerd 不读这一项）。

uci -q get dockerd.globals >/dev/null || exit 0
[ "$(uci -q get dockerd.globals.sight_ttyd_login_disabled)" = 1 ] && exit 0

changed=0
for s in $(uci -q show ttyd | sed -n 's/^ttyd\.\([^.=]*\)=ttyd$/\1/p'); do
	[ "$(uci -q get ttyd.$s.command)" = /bin/login ] || continue
	[ -z "$(uci -q get ttyd.$s.enable)" ] || continue
	uci set ttyd.$s.enable=0
	changed=1
done
[ "$changed" = 1 ] && uci commit ttyd
uci set dockerd.globals.sight_ttyd_login_disabled=1
uci commit dockerd

[ "$changed" = 1 ] && [ -x /etc/init.d/ttyd ] && /etc/init.d/ttyd restart >/dev/null 2>&1
exit 0
