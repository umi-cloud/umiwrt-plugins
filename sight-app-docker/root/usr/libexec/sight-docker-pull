#!/usr/bin/ucode
'use strict';
/*
 * 由 sight.docker pull_start 在后台启动：按 /tmp/sight-docker/pull.json 里已校验的引用调用
 * POST /images/create，把 Docker 的逐行 JSON 进度汇总写回同一文件，页面经 pull_status 轮询。
 * 不接受命令行参数，引用不经过 shell。
 */
import { readfile, writefile, rename } from 'fs';
import * as socket from 'socket';
import { cursor } from 'uci';
import * as ds from 'sight.docker_socket';

const TASK = '/tmp/sight-docker/pull.json';
/* 守护进程超过这么久没有任何输出视为卡住（毫秒） */
const IDLE_TIMEOUT = 300000;

const task = (() => { try { return json(readfile(TASK) || ''); } catch { return null; } })();
if (!task || task.state != 'running' || !task.from || !task.tag) exit(1);
task.pid = int(split(readfile('/proc/self/stat') || '', ' ')[0]);

let written = 0;
function save(force) {
	if (!force && time() == written) return;
	written = time();
	writefile(TASK + '.tmp', sprintf('%J', task));
	rename(TASK + '.tmp', TASK);
}
function finish(state, error) {
	task.state = state;
	if (error) task.error = error;
	task.finished = time();
	save(true);
	exit(state == 'done' ? 0 : 1);
}
save(true);

function urlencode(value) {
	return replace('' + value, /[^A-Za-z0-9_.~-]/g, (c) => sprintf('%%%02X', ord(c)));
}

/* 进度：按层汇总下载字节；已存在或已完成的层计满 */
const layers = {};
function progress(msg) {
	if (msg.error || msg.errorDetail) return finish('failed', msg.errorDetail?.message || msg.error);
	const status = msg.status || '';
	if (!msg.id || match(status, /^(Pulling from|Digest:|Status:)/)) {
		if (status) task.status = status;
		return;
	}
	if (!layers[msg.id]) layers[msg.id] = { current: 0, total: 0, done: false };
	const l = layers[msg.id];
	const detail = msg.progressDetail || {};
	if (status == 'Downloading' && detail.total) { l.total = detail.total; l.current = detail.current || 0; }
	else if (match(status, /^(Download complete|Verifying Checksum|Extracting|Pull complete|Already exists)/)) {
		l.current = l.total;
		l.done = status == 'Pull complete' || status == 'Already exists';
	}
	let current = 0, total = 0, done = 0, count = 0;
	for (let id, x in layers) { current += x.current; total += x.total; count++; if (x.done) done++; }
	task.current = current; task.total = total; task.layers = count; task.layers_done = done;
	if (status) task.status = status;
}

const ctx = cursor();
const api = ctx.get('dockerd', 'globals', 'api_version') || '';
ctx.unload();

const dest = ds.get_socket_dest_compat();
const sock = socket.create(dest.family, socket.SOCK_STREAM);
if (!sock || !sock.connect(dest)) finish('failed', 'Failed to connect to Docker');
sock.send(join('\r\n', [
	`POST ${api ? '/' + api : ''}/images/create?fromImage=${urlencode(task.from)}&tag=${urlencode(task.tag)} HTTP/1.1`,
	'Host: docker', 'User-Agent: sight-docker-pull/1', 'Connection: close', 'Content-Length: 0', '', '',
]));

let buf = '', head = null, code = 0, chunked = false, body = '', ended = false;
/* 逐行处理已解出的正文；不完整的末行留到下次 */
function lines() {
	let nl;
	while ((nl = index(body, '\n')) >= 0) {
		const line = trim(substr(body, 0, nl));
		body = substr(body, nl + 1);
		if (!line) continue;
		let msg;
		try { msg = json(line); } catch { continue; }
		if (code < 300) progress(msg);
		else task.error = msg?.message || task.error;
	}
}
/* 分块编码：从 buf 解出完整的块追加到 body */
function dechunk() {
	while (true) {
		const m = match(buf, /^([0-9a-fA-F]+)[^\r\n]*\r\n/);
		if (!m) return;
		const size = int(m[1], 16);
		if (size == 0) { ended = true; return; }
		if (length(buf) < length(m[0]) + size + 2) return;
		body += substr(buf, length(m[0]), size);
		buf = substr(buf, length(m[0]) + size + 2);
	}
}

while (!ended) {
	const ready = socket.poll(IDLE_TIMEOUT, [sock, socket.POLLIN]);
	if (!ready || !length(ready)) { sock.close(); finish('failed', 'Docker stopped responding'); }
	const data = sock.recv(8192);
	if (!data) break;
	buf += data;
	if (!head) {
		const end = index(buf, '\r\n\r\n');
		if (end < 0) continue;
		head = substr(buf, 0, end);
		buf = substr(buf, end + 4);
		code = int(match(head, /^HTTP\/\S+\s+(\d+)/)?.[1] || 0);
		chunked = !!match(lc(head), /\r\ntransfer-encoding:\s*chunked/);
	}
	if (chunked) dechunk();
	else { body += buf; buf = ''; }
	lines();
	save(false);
}
sock.close();
body += '\n';
lines();

if (code >= 300 || !code) finish('failed', task.error || `HTTP ${code}`);
if (chunked && !ended) finish('failed', 'The connection to Docker was interrupted');
finish('done');
