{
	"sight-plugin-docker": {
		"description": "Sight Docker page: containers (create, start/stop/restart, delete, restart policy, usage, logs), image download, removal and cleanup, dockerd settings",
		"read": {
			"ubus": {
				"docker": [
					"df",
					"info",
					"version"
				],
				"docker.container": [
					"inspect",
					"list",
					"stats"
				],
				"docker.image": [
					"list"
				],
				"docker.network": [
					"list"
				],
				"sight.docker": [
					"logs",
					"pull_status"
				]
			},
			"uci": [
				"dockerd"
			]
		},
		"write": {
			"ubus": {
				"docker.container": [
					"create",
					"remove",
					"restart",
					"start",
					"stop",
					"update"
				],
				"docker.image": [
					"prune",
					"remove"
				],
				"sight.docker": [
					"pull_start"
				]
			},
			"uci": [
				"dockerd"
			]
		}
	}
}
