'use strict';

import { access, error, lsdir, lstat, mkdir, popen, readfile, rmdir, writefile } from 'fs';
import * as socket from 'socket';
import { connect } from 'ubus';
import { cursor } from 'uci';
import { STATUS, fail, shellquote } from 'sight.rpc';

function hasKernelModule(kmod) {
	return (system(sprintf('[ -e "/lib/modules/$(uname -r)"/%s ]', shellquote(kmod))) === 0);
}

const HP_DIR = '/etc/homeproxy';
const RUN_DIR = '/var/run/homeproxy';

/* 节点延迟：只走 UDP 的协议连 TCP 端口没有意义，交给页面另行处理 */
const UDP_TYPES = ['hysteria', 'hysteria2', 'tuic', 'wireguard'];
const LATENCY_MAX_NODES = 128, LATENCY_TIMEOUT = 3000;
const ECONNREFUSED = 111;

/* sing-box 核心的检查与更新：apk 联网可能超过 rpcd 调用超时，交给后台任务，页面轮询 core_task */
const CORE_DIR = '/tmp/sight-homeproxy';
const CORE_TASK = CORE_DIR + '/core.json', CORE_LOG = CORE_DIR + '/core.log', CORE_LOCK = CORE_DIR + '/start.lock';
const CORE_RUNNER = '/usr/libexec/sight-homeproxy-core';
const CORE_OUTPUT_LIMIT = 8192;
/* /proc/<pid>/stat 的时间单位；OpenWrt 内核均为 100 */
const CLK_TCK = 100;

function read_json(path) {
	try { return json(readfile(path) || ''); } catch { return null; }
}
/* /proc/<pid>/stat 中进程名之后的字段：[0] 状态、[1] 父进程、[19] 启动时刻（开机后的时钟滴答数） */
function stat_fields(pid) {
	const stat = readfile(`/proc/${pid}/stat`);
	const end = stat ? rindex(stat, ')') : -1;
	return end < 0 ? null : split(trim(substr(stat, end + 1)), ' ');
}
/* 后台任务的状态；进程已不在（被杀、异常退出）却仍标着 running 时改记为失败 */
function core_task_state() {
	const t = read_json(CORE_TASK);
	if (t?.state === 'running' && t.pid && !access(`/proc/${t.pid}`)) {
		t.state = 'failed';
		t.code = -1;
	}
	return t;
}

function monotonicMs() {
	const c = clock(true);
	return c[0] * 1000 + c[1] / 1000000;
}

const methods = {
	acllist_read: {
		args: { type: 'type' },
		call: function(req) {
			if (index(['direct_list', 'proxy_list'], req.args?.type) === -1)
				return { content: null, error: 'illegal type' };

			const filecontent = readfile(`${HP_DIR}/resources/${req.args?.type}.txt`);
			return { content: filecontent };
		}
	},
	acllist_write: {
		args: { type: 'type', content: 'content' },
		call: function(req) {
			if (index(['direct_list', 'proxy_list'], req.args?.type) === -1)
				return { result: false, error: 'illegal type' };

			const file = `${HP_DIR}/resources/${req.args?.type}.txt`;
			let content = req.args?.content;

			/* Sanitize content */
			if (content) {
				content = trim(content);
				content = replace(content, /\r\n?/g, '\n');
				if (!match(content, /\n$/))
					content += '\n';
			}

			system(`mkdir -p ${HP_DIR}/resources`);
			writefile(file, content);

			return { result: true };
		}
	},

	certificate_write: {
		args: { filename: 'filename' },
		call: function(req) {
			const writeCertificate = (filename, priv) => {
				const tmpcert = '/tmp/homeproxy_certificate.tmp';
				const filestat = lstat(tmpcert);

				if (!filestat || filestat.type !== 'file' || filestat.size <= 0) {
					system(`rm -f ${tmpcert}`);
					return { result: false, error: 'empty certificate file' };
				}

				let filecontent = readfile(tmpcert);
				if (is_binary(filecontent)) {
					system(`rm -f ${tmpcert}`);
					return { result: false, error: 'illegal file type: binary' };
				}

				/* Kanged from luci-proto-openconnect */
				const beg = priv ? /^-----BEGIN (RSA|EC) PRIVATE KEY-----$/ : /^-----BEGIN CERTIFICATE-----$/,
				      end = priv ? /^-----END (RSA|EC) PRIVATE KEY-----$/ : /^-----END CERTIFICATE-----$/,
				      lines = split(trim(filecontent), /[\r\n]/);
				let start = false, i;

				for (i = 0; i < length(lines); i++) {
					if (match(lines[i], beg))
						start = true;
					else if (start && !b64dec(lines[i]) && length(lines[i]) !== 64)
						break;
				}

				if (!start || i < length(lines) - 1 || !match(lines[i], end)) {
					system(`rm -f ${tmpcert}`);
					return { result: false, error: 'this does not look like a correct PEM file' };
				}

				/* Sanitize certificate */
				filecontent = trim(filecontent);
				filecontent = replace(filecontent, /\r\n?/g, '\n');
				if (!match(filecontent, /\n$/))
					filecontent += '\n';

				system(`mkdir -p ${HP_DIR}/certs`);
				writefile(`${HP_DIR}/certs/${filename}.pem`, filecontent);
				system(`rm -f ${tmpcert}`);

				return { result: true };
			};

			const filename = req.args?.filename;
			switch (filename) {
			case 'client_ca':
			case 'server_publickey':
				return writeCertificate(filename, false);
				break;
			case 'server_privatekey':
				return writeCertificate(filename, true);
				break;
			default:
				return { result: false, error: 'illegal cerificate filename' };
				break;
			}
		}
	},

	/*
	 * sing-box 运行期的致命错误（启动后退出）由 procd 记进系统日志，不在 sing-box-c.log 里：
	 * 取系统日志中最近几条 sing-box 的 FATAL 与 procd 的崩溃循环记录，原样返回，由页面判断时间先后
	 */
	client_errors: {
		call: function() {
			const lines = [];
			const fd = popen("logread -e 'sing-box' 2>/dev/null");
			if (fd) {
				for (let line = fd.read('line'); length(line); line = fd.read('line')) {
					line = rtrim(line, '\n');
					if ((match(line, / sing-box\[\d+\]: /) && index(line, 'FATAL') !== -1) || index(line, 'homeproxy::sing-box-c') !== -1) {
						push(lines, line);
						if (length(lines) > 5)
							shift(lines);
					}
				}
				fd.close();
			}
			return { lines };
		}
	},

	/* sing-box 客户端进程的运行时长与内存。开启 ujail 时 procd 记录的是 ujail，sing-box 是它的子进程 */
	client_status: {
		call: function() {
			const ubus = connect();
			const inst = ubus?.call('service', 'list', { name: 'homeproxy' })?.homeproxy?.instances?.['sing-box-c'];
			ubus?.disconnect();
			if (!inst?.running || !inst.pid)
				return { running: false };

			let pid = inst.pid;
			if (trim(readfile(`/proc/${pid}/comm`) || '') !== 'sing-box')
				for (let p in lsdir('/proc') || [])
					if (match(p, /^\d+$/) && stat_fields(p)?.[1] == `${pid}` && trim(readfile(`/proc/${p}/comm`) || '') === 'sing-box') {
						pid = int(p);
						break;
					}

			const start = stat_fields(pid)?.[19];
			const boot = +split(readfile('/proc/uptime') || '', ' ')[0];
			const rss = match(readfile(`/proc/${pid}/status`) || '', /VmRSS:\s+(\d+) kB/);
			return {
				running: true,
				uptime: start ? max(0, int(boot - int(start) / CLK_TCK)) : null,
				memory: rss ? int(rss[1]) * 1024 : null
			};
		}
	},

	/* 最近一次核心检查或更新的结果与输出；supported 为 false 表示设备不用 apk，页面不提供更新 */
	core_task: {
		call: function() {
			const t = core_task_state();
			let output = t ? (readfile(CORE_LOG) || '') : '';
			if (length(output) > CORE_OUTPUT_LIMIT)
				output = substr(output, length(output) - CORE_OUTPUT_LIMIT);
			return { supported: !!access('/usr/bin/apk'), task: t, output };
		}
	},

	/* 开始检查（check）或更新（upgrade）sing-box；已有任务在进行时不另起，返回进行中的任务 */
	core_start: {
		args: { action: 'action' },
		call: function(req) {
			const action = req.args?.action;
			if (!(action in ['check', 'upgrade']))
				return fail(req, STATUS.INVALID_ARGUMENT);
			if (!access('/usr/bin/apk'))
				return fail(req, STATUS.NOT_SUPPORTED);

			mkdir(CORE_DIR);
			if (!mkdir(CORE_LOCK))
				return { task: core_task_state() };
			const current = core_task_state();
			if (current?.state === 'running') {
				rmdir(CORE_LOCK);
				return { task: current };
			}
			const t = { action, state: 'running', started: time() };
			writefile(CORE_TASK, sprintf('%J', t));
			writefile(CORE_LOG, '');
			system(`${CORE_RUNNER} ${action} ${t.started} </dev/null >>${CORE_LOG} 2>&1 &`);
			rmdir(CORE_LOCK);
			return { task: t };
		}
	},

	connection_check: {
		args: { site: 'site' },
		call: function(req) {
			let url;
			switch(req.args?.site) {
			case 'baidu':
				url = 'https://www.baidu.com';
				break;
			case 'google':
				url = 'https://www.google.com';
				break;
			default:
				return { result: false, error: 'illegal site' };
				break;
			}

			return { result: (system(`/usr/bin/wget --spider -qT3 ${url} 2>"/dev/null"`, 3100) === 0) };
		}
	},

	log_clean: {
		args: { type: 'type' },
		call: function(req) {
			if (!(req.args?.type in ['homeproxy', 'sing-box-c', 'sing-box-s']))
				return { result: false, error: 'illegal type' };

			const filestat = lstat(`${RUN_DIR}/${req.args?.type}.log`);
			if (filestat)
				writefile(`${RUN_DIR}/${req.args?.type}.log`, '');
			return { result: true };
		}
	},

	/*
	 * 路由器到各节点服务器端口的 TCP 握手耗时（不经代理）：先逐个解析地址，再一起非阻塞 connect，
	 * 最多等 LATENCY_TIMEOUT。结果为毫秒，或 'timeout' / 'refused' / 'unresolved' / 'udp' / 'error'
	 */
	node_latency: {
		args: { nodes: [] },
		call: function(req) {
			const ids = req.args?.nodes;
			if (type(ids) !== 'array' || length(ids) > LATENCY_MAX_NODES)
				return fail(req, STATUS.INVALID_ARGUMENT);

			const uci = cursor();
			const results = {}, targets = [];
			for (let id in ids) {
				if (type(id) !== 'string' || id in results)
					continue;
				const node = uci.get_all('homeproxy', id);
				if (node?.['.type'] !== 'node') {
					results[id] = 'error';
					continue;
				}
				const port = int(node.port);
				if (node.type in UDP_TYPES || node.transport === 'quic')
					results[id] = 'udp';
				else if (!node.address || !(port >= 1 && port <= 65535))
					results[id] = 'error';
				else {
					const ai = socket.addrinfo(replace(node.address, /^\[|\]$/g, ''), `${port}`, { socktype: socket.SOCK_STREAM });
					if (ai?.[0])
						push(targets, { id, ai: ai[0] });
					else
						results[id] = 'unresolved';
				}
			}

			const pending = [];
			for (let t in targets) {
				const sock = socket.create(t.ai.family, socket.SOCK_STREAM | socket.SOCK_NONBLOCK);
				const start = monotonicMs();
				if (!sock)
					results[t.id] = 'error';
				else if (sock.connect(t.ai.addr) || socket.error(true) === 115 /* EINPROGRESS */)
					push(pending, { id: t.id, sock, start });
				else {
					results[t.id] = 'error';
					sock.close();
				}
			}

			const deadline = monotonicMs() + LATENCY_TIMEOUT;
			while (length(pending) && monotonicMs() < deadline) {
				const ready = socket.poll(max(1, int(deadline - monotonicMs())), ...map(pending, p => [p.sock, socket.POLLOUT]));
				const now = monotonicMs();
				for (let r in ready) {
					if (!(r[1] & (socket.POLLOUT | socket.POLLERR | socket.POLLHUP)))
						continue;
					for (let p in pending)
						if (p.sock === r[0] && !p.done) {
							const err = p.sock.getopt(socket.SOL_SOCKET, socket.SO_ERROR);
							results[p.id] = err ? (err === ECONNREFUSED ? 'refused' : 'error') : max(1, int(now - p.start + 0.5));
							p.sock.close();
							p.done = true;
						}
				}
				for (let i = length(pending) - 1; i >= 0; i--)
					if (pending[i].done)
						splice(pending, i, 1);
			}
			for (let p in pending) {
				results[p.id] = 'timeout';
				p.sock.close();
			}

			return { results };
		}
	},

	singbox_generator: {
		args: { type: 'type', params: 'params' },
		call: function(req) {
			if (!(req.args?.type in ['ech-keypair', 'uuid', 'reality-keypair', 'vapid-keypair', 'wg-keypair']))
				return { result: false, error: 'illegal type' };

			const type = req.args?.type;
			let result = {};

			const fd = popen(`/usr/bin/sing-box generate ${type} ${shellquote(req.args?.params || '')}`);
			if (fd) {
				let ech_cfg_set = false;
				let ech_key_set = false;

				for (let line = fd.read('line'); length(line); line = fd.read('line')) {
					if (type === 'uuid')
						result.uuid = trim(line);
					else if (type in ['reality-keypair', 'vapid-keypair', 'wg-keypair']) {
						let priv = match(trim(line), /PrivateKey: (.*)/);
						if (priv)
							result.private_key = priv[1];
						let pub = match(trim(line), /PublicKey: (.*)/);
						if (pub)
							result.public_key = pub[1];
					} else if (type in ['ech-keypair']) {
						if (trim(line) === '-----BEGIN ECH CONFIGS-----')
							ech_cfg_set = true;
						else if (trim(line) === '-----BEGIN ECH KEYS-----')
							ech_key_set = true;

						if (ech_cfg_set)
							result.ech_cfg = result.ech_cfg ? result.ech_cfg + '\n' + trim(line) : trim(line) ;
						if (ech_key_set)
							result.ech_key = result.ech_key ? result.ech_key + '\n' + trim(line) : trim(line) ;

						if (trim(line) === '-----END ECH CONFIGS-----')
							ech_cfg_set = false;
						else if (trim(line) === '-----END ECH KEYS-----')
							ech_key_set = false;
					}
				}

				fd.close();
			}

			return { result };
		}
	},

	singbox_get_features: {
		call: function() {
			let features = {};

			const fd = popen('/usr/bin/sing-box version');
			if (fd) {
				for (let line = fd.read('line'); length(line); line = fd.read('line')) {
					if (match(trim(line), /^sing-box version (.*)/))
						features.version = match(trim(line), /^sing-box version (.*)/)[1];

					let tags = match(trim(line), /^Tags: (.*)/);
					if (tags)
						for (let i in split(tags[1], ','))
							features[i] = true;
				}

				fd.close();
			}

			features.hp_has_ip_full = access('/usr/libexec/ip-full');
			features.hp_has_tcp_brutal = hasKernelModule('brutal.ko');
			features.hp_has_tproxy = hasKernelModule('nft_tproxy.ko') || access('/etc/modules.d/nft-tproxy');
			features.hp_has_tun = hasKernelModule('tun.ko') || access('/etc/modules.d/30-tun');

			return features;
		}
	},

	resources_get_version: {
		args: { type: 'type' },
		call: function(req) {
			const version = trim(readfile(`${HP_DIR}/resources/${req.args?.type}.ver`));
			return { version: version, error: error() };
		}
	},
	resources_update: {
		args: { type: 'type' },
		call: function(req) {
			if (req.args?.type) {
				const type = shellquote(req.args?.type);
				const exit_code = system(`${HP_DIR}/scripts/update_resources.sh ${type}`);
				return { status: exit_code };
			} else
				return { status: 255, error: 'illegal type' };
		}
	}
};

return { 'sight.homeproxy': methods };
