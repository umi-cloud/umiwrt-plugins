{
	"sight-plugin-homeproxy": {
		"description": "Sight HomeProxy page: status and diagnosis, nodes and latency, routing, domain lists, subscriptions, resources, sing-box core and logs",
		"read": {
			"ubus": {
				"service": [
					"list"
				],
				"sight.homeproxy": [
					"acllist_read",
					"client_errors",
					"client_status",
					"connection_check",
					"core_task",
					"node_latency",
					"resources_get_version",
					"singbox_get_features"
				]
			},
			"file": {
				"/bin/ping -4 -c 3 -W 1 *": [
					"exec"
				],
				"/etc/homeproxy/subscription_status.json": [
					"read"
				],
				"/var/run/homeproxy/homeproxy.log": [
					"read"
				],
				"/var/run/homeproxy/sing-box-c.log": [
					"read"
				]
			},
			"uci": [
				"homeproxy"
			]
		},
		"write": {
			"ubus": {
				"sight": [
					"setInitAction"
				],
				"sight.homeproxy": [
					"acllist_write",
					"core_start",
					"log_clean",
					"resources_update"
				]
			},
			"file": {
				"/etc/homeproxy/scripts/update_subscriptions.uc": [
					"exec"
				]
			},
			"uci": [
				"homeproxy"
			]
		}
	}
}
