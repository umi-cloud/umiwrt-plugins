#!/bin/sh
# 由 sight.homeproxy 的 core_start 在后台启动：检查或更新 sing-box，结果写回 /tmp/sight-homeproxy/core.json
# 参数：动作（check | upgrade） 开始时间（Unix 秒）
DIR=/tmp/sight-homeproxy
action="$1" started="$2"
case "$started" in ''|*[!0-9]*) started=0 ;; esac

# 结果文件是手工拼的 JSON：写进去的值只保留版本号允许的字符，避免 apk 输出里的引号破坏文件
clean() {
	printf '%s' "$1" | tr -cd 'A-Za-z0-9._~+-'
}
state() {
	printf '{"action":"%s","state":"%s","started":%s,"pid":%s%s}\n' \
		"$action" "$1" "$started" "$$" "$2" > "$DIR/core.json.tmp"
	mv "$DIR/core.json.tmp" "$DIR/core.json"
}
installed() {
	clean "$(apk query --installed --network=no --format json --fields version sing-box 2>/dev/null | jsonfilter -e '@[0].version')"
}
client_running() {
	[ "$(ubus call service list '{"name":"homeproxy"}' 2>/dev/null | jsonfilter -e '@.homeproxy.instances["sing-box-c"].running')" = "true" ]
}
# 被中止时也留下结果，页面不会一直显示进行中
trap 'state failed ",\"code\":143,\"finished\":$(date +%s)"; exit 143' TERM INT

state running ""
current="$(installed)"
case "$action" in
	check)
		# 刷新索引；个别软件源失败（如插件源暂时访问不到）不算检查失败，只要能算出结果
		apk update
		update_rc=$?
		# 有新版时模拟升级会输出 "Upgrading sing-box (旧 -> 新)"
		simulate="$(apk upgrade --simulate --network=no sing-box 2>/dev/null)"
		simulate_rc=$?
		latest="$(clean "$(printf '%s\n' "$simulate" | sed -n 's/.*Upgrading sing-box (.* -> \([^)]*\)).*/\1/p' | head -n 1)")"
		# 模拟升级失败就无法判断有没有新版；索引没刷新成功（update_code 非 0）只作提示
		rc=$simulate_rc
		extra=",\"current\":\"$current\",\"latest\":\"$latest\",\"update_code\":$update_rc"
		;;
	upgrade)
		# 代理在运行时，装好新版后重启，让新版本生效；重启失败（新版与配置不兼容等）单独记录：新版已装上，不算更新失败
		was_running=0
		client_running && was_running=1
		apk upgrade -U sing-box
		rc=$?
		now="$(installed)"
		restarted=false restart_failed=false
		if [ "$rc" -eq 0 ] && [ "$now" != "$current" ] && [ "$was_running" = 1 ]; then
			if /etc/init.d/homeproxy restart; then restarted=true; else restart_failed=true; fi
		fi
		extra=",\"from\":\"$current\",\"current\":\"$now\",\"restarted\":$restarted,\"restart_failed\":$restart_failed"
		;;
	*) rc=1 extra="" ;;
esac

if [ "$rc" -eq 0 ]; then
	state done ",\"code\":0,\"finished\":$(date +%s)$extra"
else
	state failed ",\"code\":$rc,\"finished\":$(date +%s)$extra"
fi
