{
	"sight-plugin-ddns": {
		"description": "Sight DDNS page: entries, state, current address, provider list, logs and on-demand updates",
		"read": {
			"ubus": {
				"sight.ddns": [
					"get_current_ip",
					"get_ddns_state",
					"get_services_log",
					"get_services_status"
				]
			},
			"file": {
				"/usr/lib/ddns/dynamic_dns_lucihelper.sh -S * -- start": [
					"exec"
				],
				"/usr/lib/ddns/dynamic_dns_lucihelper.sh -S * -- stop": [
					"exec"
				],
				"/usr/share/ddns/default": [
					"list"
				],
				"/usr/share/ddns/default/*": [
					"read"
				]
			},
			"uci": [
				"ddns"
			]
		},
		"write": {
			"uci": [
				"ddns"
			]
		}
	}
}
